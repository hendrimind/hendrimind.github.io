{
  "version": 2,
  "builds": [
    {
      "src": "api/**/*.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/api/health",
      "dest": "/api/health.js"
    },
    {
      "src": "/api/auth/login",
      "dest": "/api/auth/login.js"
    },
    {
      "src": "/api/auth/verify",
      "dest": "/api/auth/verify.js"
    },
    {
      "src": "/api/contact",
      "methods": ["GET", "POST"],
      "dest": "/api/contact.js"
    },
    {
      "src": "/api/contact/(.*)",
      "methods": ["PUT", "DELETE"],
      "dest": "/api/contact/[id].js"
    },
    {
      "src": "/api/gallery",
      "methods": ["GET", "POST"],
      "dest": "/api/gallery.js"
    },
    {
      "src": "/api/gallery/(.*)",
      "methods": ["GET", "PUT", "DELETE"],
      "dest": "/api/gallery/[id].js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "NODE_ENV": "production"
  }
}
